# SPDX-License-Identifier: GPL-2.0-only

chip soc/intel/skylake
	register "panel_cfg" = "{
		.up_delay_ms		= 200,	// T3
		.down_delay_ms		=  50,	// T10
		.cycle_delay_ms		= 500,	// T12
		.backlight_on_delay_ms	=  20,	// T7
		.backlight_off_delay_ms	= 200,	// T9
		.backlight_pwm_hz	= 200,
	}"

	# IGD Displays
	register "gfx" = "GMA_STATIC_DISPLAYS(0)"

	# FSP Configuration
	register "SkipExtGfxScan" = "1"
	register "SaGv" = "SaGv_Enabled"
	register "eist_enable" = "true"

	register "PmConfigSlpS3MinAssert" = "2"		# 50ms
	register "PmConfigSlpS4MinAssert" = "1"		# 1s
	register "PmConfigSlpSusMinAssert" = "3"	# 500ms
	register "PmConfigSlpAMinAssert" = "3"		# 2s

	# Send an extra VR mailbox command for the PS4 exit issue
	register "SendVrMbxCmd" = "2"

	register "power_limits_config" = "{
		.tdp_pl1_override = 20,
		.tdp_pl2_override = 30,
	}"

	register "SerialIoDevMode" = "{
		[PchSerialIoIndexUart2] = PchSerialIoSkipInit, // LPSS UART
	}"

	device domain 0 on
		subsystemid 0x1558 0x6588 inherit
		device ref system_agent	on	end
		device ref igpu 	on	end
		device ref sa_thermal	on	end
		device ref thermal	on	end
		device ref heci1	on	end
		device ref sata		on
			# Ports
			register "SataPortsEnable[0]" = "true"	# M.2 SSD
			register "SataPortsEnable[1]" = "true"	# M.2 SSD
			register "SataPortsEnable[2]" = "true"	# 2.5" Disk
			register "SataPortsEnable[3]" = "true"	# ODD
			# Device Sleep
			register "SataPortsDevSlp[0]" = "true"	# M.2 SSD
			register "SataPortsDevSlp[2]" = "true"	# 2.5" Disk
		end
		device ref uart2	on	end
		device ref south_xhci	on
			# USB2
			register "usb2_ports[0]" = "USB2_PORT_MID(OC0)"		# Type-A, left
			register "usb2_ports[1]" = "USB2_PORT_TYPE_C(OC_SKIP)"	# Type-C, left
			register "usb2_ports[2]" = "USB2_PORT_MID(OC1)"		# Type-A, left
			register "usb2_ports[3]" = "USB2_PORT_FLEX(OC2)"	# 3G
			register "usb2_ports[4]" = "USB2_PORT_FLEX(OC3)"	# Type-A, right
			register "usb2_ports[5]" = "USB2_PORT_FLEX(OC_SKIP)"	# Camera
			register "usb2_ports[9]" = "USB2_PORT_FLEX(OC6)"	# Bluetooth
			# USB3
			register "usb3_ports[0]" = "USB3_PORT_DEFAULT(OC_SKIP)"	# Type-A, left
			register "usb3_ports[1]" = "USB3_PORT_DEFAULT(OC_SKIP)"	# Type-C, left
			register "usb3_ports[2]" = "USB3_PORT_DEFAULT(OC_SKIP)"	# Type-A, left
			register "usb3_ports[3]" = "USB3_PORT_DEFAULT(OC_SKIP)"	# LTE
		end
		device ref pcie_rp4	on
			device pci 00.0 on end # x1 WLAN
			register "PcieRpEnable[3]" = "true"
			register "PcieRpClkReqSupport[3]" = "true"
			register "PcieRpClkReqNumber[3]" = "4"
			register "PcieRpClkSrcNumber[3]" = "4"
			register "PcieRpLtrEnable[3]" = "true"
		end
		device ref pcie_rp5	on
			device pci 00.0 on end # x1 Card Reader
			register "PcieRpEnable[4]" = "true"
			register "PcieRpClkReqSupport[4]" = "true"
			register "PcieRpClkReqNumber[4]" = "4"
			register "PcieRpClkSrcNumber[4]" = "4"
			register "PcieRpLtrEnable[4]" = "true"
		end
		device ref pcie_rp7	on
			device pci 00.0 on end # x2 USB 3.1 Host Controller
			register "PcieRpEnable[6]" = "true"
			register "PcieRpClkReqSupport[6]" = "true"
			register "PcieRpClkReqNumber[6]" = "7"
			register "PcieRpClkSrcNumber[6]" = "7"
			register "PcieRpLtrEnable[6]" = "true"
		end
		device ref pcie_rp9	on
			device pci 00.0 on end # x4 M.2 SSD
			register "PcieRpEnable[8]" = "true"
			register "PcieRpClkReqSupport[8]" = "true"
			register "PcieRpClkReqNumber[8]" = "1"
			register "PcieRpClkSrcNumber[8]" = "1"
			register "PcieRpLtrEnable[8]" = "true"
		end
		device ref pcie_rp13	on
			device pci 00.0 on end # x1 LAN
			register "PcieRpEnable[12]" = "true"
			register "PcieRpClkReqSupport[12]" = "true"
			register "PcieRpClkReqNumber[12]" = "13"
			register "PcieRpClkSrcNumber[12]" = "13"
			register "PcieRpLtrEnable[12]" = "true"
		end
		device ref lpc_espi	on
			register "gen1_dec" = "0x000c0681"
			register "gen2_dec" = "0x000c1641"
			register "gen3_dec" = "0x00040069"
			register "serirq_mode" = "SERIRQ_CONTINUOUS"
			chip drivers/pc80/tpm
				device pnp 0c31.0 on end
			end
		end
		device ref p2sb		hidden	end
		device ref pmc		on
			register "gpe0_dw0" = "GPP_C"
			register "gpe0_dw1" = "GPP_D"
			register "gpe0_dw2" = "GPP_E"
		end
		device ref hda		on	end
		device ref smbus	on	end
		device ref fast_spi	on	end
	end
end
